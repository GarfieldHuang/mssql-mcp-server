DB_SERVER=your-server-ip-or-hostname
DB_PORT=1433
DB_DATABASE=your-database-name
DB_USER=your-readonly-user
DB_PASSWORD=your-password

# Generate with: node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('hex'))"
API_KEY=your-secret-api-key

# Only needed for HTTP mode (node server.js --http)
HTTP_PORT=3000
JWT_SECRET=your-jwt-secret
